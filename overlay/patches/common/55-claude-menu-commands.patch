+//#region Memory files
+
+// Claude Code reads CLAUDE.md (project and ~/.claude). It does NOT read
+// AGENTS.md directly — the documented pattern is a CLAUDE.md line "@AGENTS.md"
+// that imports it, which is wired up automatically when creating AGENTS.md.
+interface IMemoryFileItem extends IQuickPickItem {
+	kind: 'project' | 'global' | 'agents';
+}
+
+class ClaudeMemoryFilesAction extends Action2 {
+	constructor() {
+		super({
+			id: 'academicStudio.claudeMemoryFiles',
+			title: localize2('academicStudioClaudeMemoryFiles', "CLAUDE.md…"),
+			category: CLAUDE_CATEGORY,
+			f1: true
+		});
+	}
+
+	override async run(accessor: ServicesAccessor): Promise<void> {
+		const services = claudeServices(accessor);
+		const folder = firstFolder(services);
+		const items: IMemoryFileItem[] = [];
+		if (folder) {
+			items.push({
+				label: localize('academicStudioClaudeMemProject', "CLAUDE.md — this folder"),
+				detail: localize('academicStudioClaudeMemProjectDetail', "Project instructions Claude reads whenever it works in \"{0}\".", folder.name),
+				kind: 'project'
+			});
+		}
+		items.push({
+			label: localize('academicStudioClaudeMemGlobal', "CLAUDE.md — global"),
+			detail: localize('academicStudioClaudeMemGlobalDetail', "Personal instructions Claude reads in every project (~/.claude/CLAUDE.md)."),
+			kind: 'global'
+		});
+		if (folder) {
+			items.push({
+				label: localize('academicStudioClaudeMemAgents', "AGENTS.md — this folder"),
+				detail: localize('academicStudioClaudeMemAgentsDetail', "Cross-tool instructions. CLAUDE.md gets an \"@AGENTS.md\" line so Claude reads it too."),
+				kind: 'agents'
+			});
+		}
+
+		const picked = await services.quickInputService.pick(items, {
+			title: localize('academicStudioClaudeMemTitle', "Claude Memory Files"),
+			placeHolder: localize('academicStudioClaudeMemPlaceholder', "Instruction files Claude reads at the start of every conversation — pick one to create or edit")
+		});
+		if (!picked) {
+			return;
+		}
+
+		if (picked.kind === 'global') {
+			await ensureAndOpen(services, joinPath(await claudeHome(services), 'CLAUDE.md'), [
+				'# My Instructions for Claude (all projects)',
+				'',
+				'Claude reads this file at the start of every conversation, in every folder.',
+				'Write personal preferences here — for example:',
+				'',
+				'- Explain what you are doing in plain language.',
+				'- I use Python; prefer pandas for data work.',
+				''
+			].join('\n'));
+			return;
+		}
+
+		if (!folder) {
+			return;
+		}
+
+		if (picked.kind === 'project') {
+			await ensureAndOpen(services, joinPath(folder.uri, 'CLAUDE.md'), [
+				'# Instructions for Claude (this folder)',
+				'',
+				'Claude reads this file at the start of every conversation in this folder.',
+				'Write facts and rules about this project — for example:',
+				'',
+				'- The data files live in data/ and results go in output/.',
+				'- Always show plots with labeled axes.',
+				''
+			].join('\n'));
+			return;
+		}
+
+		// Claude only reads AGENTS.md through a CLAUDE.md import — make sure the
+		// import exists before opening AGENTS.md itself.
+		const claudeMd = joinPath(folder.uri, 'CLAUDE.md');
+		const existing = await readText(services, claudeMd) ?? '';
+		if (!/^@AGENTS\.md\s*$/m.test(existing)) {
+			try {
+				await services.fileService.writeFile(claudeMd, VSBuffer.fromString('@AGENTS.md\n' + (existing ? '\n' + existing : '')));
+			} catch (e) {
+				// leave AGENTS.md usable even if CLAUDE.md is unwritable
+			}
+		}
+		await ensureAndOpen(services, joinPath(folder.uri, 'AGENTS.md'), [
+			'# Instructions for AI agents',
+			'',
+			'Instructions any AI coding tool should follow when working in this folder.',
+			''
+		].join('\n'));
+	}
+}
+
+//#endregion
+
+//#region Skills and connectors: on or off, open, delete
+
+// Skills… and Connectors… each list every item with its state; picking one
+// opens a small follow-up menu (turn on or off, open, delete or remove).
+// MCP servers: user scope in ~/.claude.json (mcpServers), local scope under
+// projects[<path>].mcpServers there, project scope in <folder>/.mcp.json.
+// Guided installs stay in Run Setup's package catalog.
+//
+// Turning a skill or connector off writes the setting Claude Code itself uses
+// for that, so it holds in the chat panel and the terminal alike, and nothing
+// is deleted:
+//   - a skill:             "skillOverrides": { "<name>": "off" }
+//   - a plugin's skills:   "enabledPlugins": { "<plugin>@<marketplace>": false }
+//                          (Claude Code ignores skillOverrides for plugin
+//                          skills, so they go on and off with their plugin)
+//   - a .mcp.json server:  "disabledMcpjsonServers": [ "<name>" ]
+//   - any other server:    "deniedMcpServers": [ { "serverName": "<name>" } ],
+//                          where a plugin's server is named plugin:<plugin>:<server>
+// (A `Skill(name)` or `mcp__<server>` permission deny rule is NOT enough: the
+// skill stays listed and invocable as /name, and the server still connects.)
+// Global items go in ~/.claude/settings.json; this-folder items in
+// <folder>/.claude/settings.local.json, which is personal and not checked in.
+// Off in either file counts as off, so turning an item on clears it from both.
+interface IToggleFiles {
+	readonly user: URI;
+	readonly folder: URI | undefined;
+}
+
+async function toggleFiles(services: IClaudeServices): Promise<IToggleFiles> {
+	const folder = firstFolder(services);
+	return {
+		user: joinPath(await claudeHome(services), 'settings.json'),
+		folder: folder ? joinPath(folder.uri, '.claude', 'settings.local.json') : undefined
+	};
+}
+
+/** The parsed settings file, `{}` when absent. Throws on a file that is not valid JSON. */
+async function readSettings(services: IClaudeServices, resource: URI): Promise<any> {
+	const text = await readText(services, resource);
+	if (text === undefined || !text.trim()) {
+		return {};
+	}
+	const settings = JSON.parse(text);
+	if (!settings || typeof settings !== 'object' || Array.isArray(settings)) {
+		throw new Error(localize('academicStudioClaudeSettingsNotObject', "the file does not hold a JSON object"));
+	}
+	return settings;
+}
+
+/** What turns one skill, plugin or connector on and off: see the comment above. */
+interface ISwitch {
+	readonly kind: 'skill' | 'plugin' | 'mcpjson' | 'mcp';
+	readonly key: string;
+	/** where turning it off is written */
+	readonly settingsFile: URI;
+}
+
+function objectAt(settings: any, field: string): Record<string, any> | undefined {
+	const value = settings?.[field];
+	return value && typeof value === 'object' && !Array.isArray(value) ? value : undefined;
+}
+
+function arrayAt(settings: any, field: string): any[] {
+	return Array.isArray(settings?.[field]) ? settings[field] : [];
+}
+
+function isOffIn(settings: any, sw: ISwitch): boolean {
+	switch (sw.kind) {
+		case 'skill': return objectAt(settings, 'skillOverrides')?.[sw.key] === 'off';
+		case 'plugin': return objectAt(settings, 'enabledPlugins')?.[sw.key] === false;
+		case 'mcpjson': return arrayAt(settings, 'disabledMcpjsonServers').includes(sw.key);
+		case 'mcp': return arrayAt(settings, 'deniedMcpServers').some(entry => entry?.serverName === sw.key);
+	}
+}
+
+/** Turn `sw` off in `settings`, or clear its off state. True when that changed anything. */
+function setOffIn(settings: any, sw: ISwitch, off: boolean): boolean {
+	if (isOffIn(settings, sw) === off) {
+		return false;
+	}
+	switch (sw.kind) {
+		case 'skill': {
+			const overrides = { ...objectAt(settings, 'skillOverrides') };
+			if (off) {
+				overrides[sw.key] = 'off';
+			} else {
+				delete overrides[sw.key];
+			}
+			settings.skillOverrides = overrides;
+			if (!Object.keys(overrides).length) {
+				delete settings.skillOverrides;
+			}
+			break;
+		}
+		case 'plugin':
+			// on is an explicit true: installing a plugin enables it this same way
+			settings.enabledPlugins = { ...objectAt(settings, 'enabledPlugins'), [sw.key]: !off };
+			break;
+		case 'mcpjson':
+			settings.disabledMcpjsonServers = off
+				? [...arrayAt(settings, 'disabledMcpjsonServers'), sw.key]
+				: arrayAt(settings, 'disabledMcpjsonServers').filter(name => name !== sw.key);
+			break;
+		case 'mcp':
+			settings.deniedMcpServers = off
+				? [...arrayAt(settings, 'deniedMcpServers'), { serverName: sw.key }]
+				: arrayAt(settings, 'deniedMcpServers').filter(entry => entry?.serverName !== sw.key);
+			break;
+	}
+	return true;
+}
+
+/** Both toggle settings files, parsed. Undefined (after telling the user) when one is not valid JSON. */
+async function readToggleSettings(services: IClaudeServices, files: IToggleFiles): Promise<Map<string, { resource: URI; value: any }> | undefined> {
+	const settings = new Map<string, { resource: URI; value: any }>();
+	for (const resource of files.folder ? [files.user, files.folder] : [files.user]) {
+		try {
+			settings.set(resource.toString(), { resource, value: await readSettings(services, resource) });
+		} catch (err) {
+			services.notificationService.error(localize('academicStudioClaudeSettingsUnreadable', "Could not read {0}: {1}. Fix the file, then try again.", agentPath(resource), err instanceof Error ? err.message : String(err)));
+			return undefined;
+		}
+	}
+	return settings;
+}
+
+function isOff(settings: Map<string, { resource: URI; value: any }>, sw: ISwitch): boolean {
+	for (const { value } of settings.values()) {
+		if (isOffIn(value, sw)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/**
+ * Turn one skill, plugin or connector on or off. Off is written to
+ * `sw.settingsFile`; on clears the off state from every file, since off in
+ * either one wins. Writes only the files that changed.
+ */
+async function setEnabled(services: IClaudeServices, settings: Map<string, { resource: URI; value: any }>, sw: ISwitch, on: boolean): Promise<void> {
+	const targets = on ? [...settings.values()] : [settings.get(sw.settingsFile.toString())];
+	for (const entry of targets) {
+		if (entry && setOffIn(entry.value, sw, !on)) {
+			await services.fileService.writeFile(entry.resource, VSBuffer.fromString(JSON.stringify(entry.value, undefined, 2) + '\n'));
+		}
+	}
+}
+
+function onOffLabel(name: string, on: boolean): string {
+	return (on ? '$(check) ' : '$(circle-slash) ') + name;
+}
+
+function onOffDescription(on: boolean): string {
+	return on ? localize('academicStudioClaudeIsOn', "on") : localize('academicStudioClaudeIsOff', "off");
+}
+
+type FollowUp = 'toggle' | 'open' | 'delete';
+
+interface IFollowUpItem extends IQuickPickItem {
+	action: FollowUp;
+}
+
+/** The small menu shown after picking a skill or connector. Undefined when dismissed. */
+async function pickFollowUp(services: IClaudeServices, title: string, items: IFollowUpItem[]): Promise<FollowUp | undefined> {
+	const picked = await services.quickInputService.pick(items, {
+		title,
+		placeHolder: localize('academicStudioClaudeFollowUpPlaceholder', "Choose what to do — Escape goes back to the list")
+	});
+	return picked?.action;
+}
+
+interface IInstalledPlugin {
+	/** <plugin>@<marketplace>, the enabledPlugins key */
+	readonly id: string;
+	readonly name: string;
+	readonly root: URI;
+	/** user, project or local */
+	readonly scope: string;
+}
+
+/** Installed plugins, from ~/.claude/plugins/installed_plugins.json. */
+async function installedPlugins(services: IClaudeServices): Promise<IInstalledPlugin[]> {
+	const home = await claudeHome(services);
+	const text = await readText(services, joinPath(home, 'plugins', 'installed_plugins.json'));
+	if (text === undefined) {
+		return [];
+	}
+	const plugins: IInstalledPlugin[] = [];
+	try {
+		for (const [id, installs] of Object.entries<any>(JSON.parse(text).plugins ?? {})) {
+			const install = Array.isArray(installs) ? installs[0] : undefined;
+			if (typeof install?.installPath === 'string') {
+				// installPath is a path on the machine Claude Code runs on; keep the home's scheme and authority.
+				plugins.push({ id, name: id.split('@')[0], root: home.with({ path: URI.file(install.installPath).path }), scope: typeof install.scope === 'string' ? install.scope : 'user' });
+			}
+		}
+	} catch (e) {
+		// unparsable — no plugins listed
+	}
+	return plugins.sort((a, b) => a.name.localeCompare(b.name));
+}
+
+/** The name Claude invokes a skill by: its frontmatter `name`, else its folder name. */
+async function skillInvocationName(services: IClaudeServices, item: ISkillItem): Promise<string> {
+	const text = await readText(services, joinPath(item.skillRoot, item.skillName, 'SKILL.md'));
+	const match = text?.match(/^name:\s*["']?(.+?)["']?\s*$/m);
+	return match ? match[1] : item.skillName;
+}
+
+function mcpServersIn(text: string | undefined): [string, any][] {
+	if (text === undefined) {
+		return [];
+	}
+	try {
+		const config = JSON.parse(text);
+		return Object.entries<any>(config?.mcpServers ?? {});
+	} catch (e) {
+		return []; // unparsable config — skip
+	}
+}
+
+interface ISkillEntry extends IQuickPickItem {
+	/** `plugin` is set for a plugin's skill, which goes on and off with its whole plugin */
+	skill?: { folder: URI; name: string; sw: ISwitch; plugin?: string; deletable: boolean; on: boolean };
+	command?: string;
+	url?: string;
+}
+
+class ClaudeSkillsAction extends Action2 {
+	constructor() {
+		super({
+			id: 'academicStudio.claudeSkills',
+			title: localize2('academicStudioClaudeSkills', "Skills…"),
+			category: CLAUDE_CATEGORY,
+			f1: true
+		});
+	}
+
+	override async run(accessor: ServicesAccessor): Promise<void> {
+		const services = claudeServices(accessor);
+		// After turning a skill on or off, or deleting one, come back to the
+		// refreshed list; opening a skill, or Escape on the list, ends it.
+		while (true) {
+			const files = await toggleFiles(services);
+			const settings = await readToggleSettings(services, files);
+			if (!settings) {
+				return;
+			}
+
+			const items: QuickPickInput<ISkillEntry>[] = [];
+			const addGroup = async (label: string, dir: URI, settingsFile: URI, plugin?: IInstalledPlugin) => {
+				const skills = await listSkillsIn(services, dir);
+				if (!skills.length) {
+					return;
+				}
+				items.push({ type: 'separator', label });
+				for (const skill of skills) {
+					const name = (plugin ? plugin.name + ':' : '') + await skillInvocationName(services, skill);
+					const sw: ISwitch = plugin
+						? { kind: 'plugin', key: plugin.id, settingsFile: plugin.scope === 'user' ? files.user : files.folder ?? files.user }
+						: { kind: 'skill', key: name, settingsFile };
+					const on = !isOff(settings, sw);
+					items.push({
+						label: onOffLabel(name, on),
+						description: onOffDescription(on),
+						detail: skill.detail,
+						skill: { folder: joinPath(skill.skillRoot, skill.skillName), name, sw, plugin: plugin?.name, deletable: !plugin, on }
+					});
+				}
+			};
+
+			const localDir = localSkillsDir(services);
+			if (localDir && files.folder) {
+				await addGroup(localize('academicStudioClaudeSkillsLocal', "Local — this folder only"), localDir, files.folder);
+			}
+			await addGroup(localize('academicStudioClaudeSkillsGlobal', "Global — every project"), joinPath(await claudeHome(services), 'skills'), files.user);
+			for (const plugin of await installedPlugins(services)) {
+				await addGroup(localize('academicStudioClaudeSkillsPlugin', "From the {0} plugin", plugin.name), joinPath(plugin.root, 'skills'), files.user, plugin);
+			}
+			const hasSkills = items.length > 0;
+
+			items.push({ type: 'separator' });
+			items.push({ label: '$(add) ' + localize('academicStudioClaudeSkillsCreate', "Create Skill…"), command: 'academicStudio.claudeNewSkill' });
+			items.push({ label: '$(globe) ' + localize('academicStudioClaudeSkillsSearch', "Search Anthropic"), detail: localize('academicStudioClaudeSkillsSearchDetail', "Anthropic's public skills collection"), url: SKILLS_URL });
+
+			const picked = await services.quickInputService.pick(items, {
+				title: localize('academicStudioClaudeSkillsTitle', "Claude Skills"),
+				placeHolder: hasSkills
+					? localize('academicStudioClaudeSkillsPlaceholder', "Select a skill to turn it on or off, open it, or delete it")
+					: localize('academicStudioClaudeSkillsEmpty', "No skills installed yet. Skills are step-by-step instructions Claude can follow for specialized tasks.")
+			});
+			if (!picked) {
+				return;
+			}
+			if (picked.command) {
+				await services.commandService.executeCommand(picked.command);
+				return;
+			}
+			if (picked.url) {
+				await openUrl(services, picked.url);
+				return;
+			}
+			const skill = picked.skill;
+			if (!skill) {
+				return;
+			}
+
+			const followUps: IFollowUpItem[] = [
+				skill.plugin
+					? skill.on
+						? { action: 'toggle', label: '$(circle-slash) ' + localize('academicStudioClaudePluginTurnOff', "Turn Off the {0} Plugin", skill.plugin), detail: localize('academicStudioClaudePluginTurnOffDetail', "A plugin's skills go on and off together: this turns off all of its skills and connectors. Nothing is deleted.") }
+						: { action: 'toggle', label: '$(check) ' + localize('academicStudioClaudePluginTurnOn', "Turn On the {0} Plugin", skill.plugin), detail: localize('academicStudioClaudePluginTurnOnDetail', "Claude can use all of its skills and connectors again.") }
+					: skill.on
+						? { action: 'toggle', label: '$(circle-slash) ' + localize('academicStudioClaudeSkillTurnOff', "Turn Off"), detail: localize('academicStudioClaudeSkillTurnOffDetail', "Claude stops using this skill. Nothing is deleted.") }
+						: { action: 'toggle', label: '$(check) ' + localize('academicStudioClaudeSkillTurnOn', "Turn On"), detail: localize('academicStudioClaudeSkillTurnOnDetail', "Claude can use this skill again.") },
+				{ action: 'open', label: '$(go-to-file) ' + localize('academicStudioClaudeSkillOpen', "Open Instructions"), detail: 'SKILL.md' }
+			];
+			if (skill.deletable) {
+				followUps.push({ action: 'delete', label: '$(trash) ' + localize('academicStudioClaudeSkillDelete', "Delete"), detail: localize('academicStudioClaudeSkillDeleteDetail', "Remove the skill's folder. This cannot be undone.") });
+			}
+			const action = await pickFollowUp(services, skill.name, followUps);
+
+			if (action === 'toggle') {
+				await setEnabled(services, settings, skill.sw, !skill.on);
+				const what = skill.plugin ? localize('academicStudioClaudePluginNamed', "the {0} plugin", skill.plugin) : skill.name;
+				services.notificationService.info(skill.on
+					? localize('academicStudioClaudeSkillTurnedOff', "Turned off {0}. Start a new chat for Claude to pick up the change.", what)
+					: localize('academicStudioClaudeSkillTurnedOn', "Turned on {0}. Start a new chat for Claude to pick up the change.", what));
+			} else if (action === 'open') {
+				await services.editorService.openEditor({ resource: joinPath(skill.folder, 'SKILL.md'), options: { pinned: true } });
+				return;
+			} else if (action === 'delete') {
+				const { confirmed } = await services.dialogService.confirm({
+					type: 'warning',
+					message: localize('academicStudioClaudeDeleteSkillConfirm', "Delete the skill \"{0}\"?", skill.name),
+					detail: localize('academicStudioClaudeDeleteSkillDetail', "Its whole folder is removed and Claude will no longer know it."),
+					primaryButton: localize('academicStudioClaudeDeleteSkillButton', "Delete Skill")
+				});
+				if (confirmed) {
+					try {
+						await services.fileService.del(skill.folder, { recursive: true, useTrash: false });
+					} catch (err) {
+						services.notificationService.error(localize('academicStudioClaudeDeleteSkillFailed', "Could not delete \"{0}\": {1}", skill.name, err instanceof Error ? err.message : String(err)));
+						return;
+					}
+					if (!skill.on) {
+						// drop the now-orphaned override
+						await setEnabled(services, settings, skill.sw, true);
+					}
+					services.notificationService.info(localize('academicStudioClaudeDeleteSkillDone', "Deleted skill \"{0}\".", skill.name));
+				}
+			}
+		}
+	}
+}
+
+
+interface IConnectorEntry extends IQuickPickItem {
+	connector?: {
+		name: string;
+		sw: ISwitch;
+		/** the file that defines it */
+		configFile: URI;
+		/** where in that file: `mcpServers` at the top, or under `projects[<path>]` */
+		projectPath?: string;
+		removable: boolean;
+		on: boolean;
+	};
+	openConfig?: boolean;
+	url?: string;
+}
+
+/** Delete one server from its config file. Refuses a file it cannot parse rather than overwrite it. */
+async function removeConnector(services: IClaudeServices, configFile: URI, name: string, projectPath: string | undefined): Promise<boolean> {
+	const text = await readText(services, configFile);
+	let config: any;
+	try {
+		config = JSON.parse(text ?? '');
+	} catch (err) {
+		services.notificationService.error(localize('academicStudioClaudeConnectorUnreadable', "Could not read {0}. Fix the file, then try again.", agentPath(configFile)));
+		return false;
+	}
+	const servers = projectPath === undefined ? config?.mcpServers : config?.projects?.[projectPath]?.mcpServers;
+	if (!servers || typeof servers !== 'object' || !(name in servers)) {
+		return false;
+	}
+	delete servers[name];
+	await services.fileService.writeFile(configFile, VSBuffer.fromString(JSON.stringify(config, undefined, 2) + '\n'));
+	return true;
+}
+
+class ClaudeConnectorsAction extends Action2 {
