+				await openUrl(services, picked.url);
+				return;
+			}
+			const connector = picked.connector;
+			if (!connector) {
+				return;
+			}
+
+			const followUps: IFollowUpItem[] = [
+				connector.on
+					? { action: 'toggle', label: '$(circle-slash) ' + localize('academicStudioClaudeConnectorTurnOff', "Turn Off"), detail: localize('academicStudioClaudeConnectorTurnOffDetail', "Claude stops connecting to it. Its configuration is kept.") }
+					: { action: 'toggle', label: '$(check) ' + localize('academicStudioClaudeConnectorTurnOn', "Turn On"), detail: localize('academicStudioClaudeConnectorTurnOnDetail', "Claude can use its tools again.") },
+				{ action: 'open', label: '$(go-to-file) ' + localize('academicStudioClaudeConnectorOpen', "Open Configuration"), detail: agentPath(connector.configFile) }
+			];
+			if (connector.removable) {
+				followUps.push({ action: 'delete', label: '$(trash) ' + localize('academicStudioClaudeConnectorRemove', "Remove"), detail: localize('academicStudioClaudeConnectorRemoveDetail', "Delete it from {0}. This cannot be undone.", agentPath(connector.configFile)) });
+			}
+			const action = await pickFollowUp(services, connector.name, followUps);
+
+			if (action === 'toggle') {
+				await setEnabled(services, settings, connector.sw, !connector.on);
+				services.notificationService.info(connector.on
+					? localize('academicStudioClaudeConnectorTurnedOff', "Turned off {0}. Start a new chat for Claude to pick up the change.", connector.name)
+					: localize('academicStudioClaudeConnectorTurnedOn', "Turned on {0}. Start a new chat for Claude to pick up the change.", connector.name));
+			} else if (action === 'open') {
+				await services.editorService.openEditor({ resource: connector.configFile, options: { pinned: true } });
+				return;
+			} else if (action === 'delete') {
+				const { confirmed } = await services.dialogService.confirm({
+					type: 'warning',
+					message: localize('academicStudioClaudeRemoveConnectorConfirm', "Remove the connector \"{0}\"?", connector.name),
+					detail: localize('academicStudioClaudeRemoveConnectorDetail', "Its entry is deleted from {0}, and Claude can no longer use its tools.", agentPath(connector.configFile)),
+					primaryButton: localize('academicStudioClaudeRemoveConnectorButton', "Remove Connector")
+				});
+				if (confirmed && await removeConnector(services, connector.configFile, connector.name, connector.projectPath)) {
+					if (!connector.on) {
+						// drop the now-orphaned off setting
+						await setEnabled(services, settings, connector.sw, true);
+					}
+					services.notificationService.info(localize('academicStudioClaudeRemoveConnectorDone', "Removed connector \"{0}\".", connector.name));
+				}
+			}
+		}
+	}
+}
+
+//#endregion
+
+//#region Plugins
+
+interface IPluginItem extends IQuickPickItem {
+	url: string;
+}
+
+class ClaudePluginsAction extends Action2 {
+	constructor() {
+		super({
+			id: 'academicStudio.claudePlugins',
+			title: localize2('academicStudioClaudePlugins', "Plugins…"),
+			category: CLAUDE_CATEGORY,
+			f1: true
+		});
+	}
+
+	override async run(accessor: ServicesAccessor): Promise<void> {
+		const services = claudeServices(accessor);
+		const picked = await services.quickInputService.pick<IPluginItem>([
+			{
+				label: localize('academicStudioClaudePluginsOfficial', "Anthropic plugins directory"),
+				detail: localize('academicStudioClaudePluginsOfficialDetail', "claude.com/plugins — browse official plugins"),
+				url: PLUGINS_URL
+			},
+			{
+				label: localize('academicStudioClaudePluginsCommunity', "Community plugins"),
+				detail: localize('academicStudioClaudePluginsCommunityDetail', "github.com/anthropics/claude-plugins-community — plugins contributed by the community"),
+				url: COMMUNITY_PLUGINS_URL
+			}
+		], {
+			title: localize('academicStudioClaudePluginsTitle', "Claude Plugins"),
+			placeHolder: localize('academicStudioClaudePluginsPlaceholder', "Plugins bundle skills, connectors, and commands you can install into Claude")
+		});
+		if (picked) {
+			await openUrl(services, picked.url);
+		}
+	}
+}
