+
+			const picked = await services.quickInputService.pick(items, {
+				title: localize('academicStudioClaudeConnectorsTitle', "Claude Connectors"),
+				placeHolder: hasConnectors
+					? localize('academicStudioClaudeConnectorsPlaceholder', "Connectors give Claude extra tools — select one to turn it on or off, open its configuration, or remove it")
+					: localize('academicStudioClaudeMcpEmpty', "No MCP connectors configured yet — packages in Run Setup can add them, or edit the configuration file")
